.card { background: rgba(16, 35, 60, 0.92); border: 1px solid var(--border)=
; border-radius: 18px; padding: 20px; box-shadow: rgba(4, 9, 18, 0.24) 0px =
18px 40px; }

.stats-grid { display: grid; gap: 16px; grid-template-columns: repeat(4, mi=
nmax(0px, 1fr)); margin-bottom: 20px; }

.stat-card h2 { margin: 8px 0px 0px; font-size: 1.8rem; }

.stat-card p { margin: 0px; color: var(--muted); }

.charts-grid { display: grid; gap: 20px; grid-template-columns: 1.25fr 1fr;=
 margin-bottom: 20px; }

.bottom-grid { display: grid; gap: 20px; grid-template-columns: 0.95fr 1.05=
fr; }

.card-head { display: flex; justify-content: space-between; align-items: ce=
nter; margin-bottom: 14px; }

.card-head h3 { margin: 6px 0px 0px; font-size: 1.1rem; }

svg { width: 100%; height: auto; }

.list { list-style: none; padding: 0px; margin: 0px; display: grid; gap: 10=
px; }

.list li { display: flex; justify-content: space-between; align-items: cent=
er; padding: 10px 0px; border-bottom: 1px solid var(--border); }

.list li:last-child { border-bottom: 0px; }

.list .pill { color: var(--good); font-weight: 600; }

table { width: 100%; border-collapse: collapse; }

