olor: var(--text); }

.page-shell { max-width: 1280px; margin: 0px auto; padding: 32px 20px 48px;=
 }

.hero { display: flex; justify-content: space-between; align-items: center;=
 gap: 16px; margin-bottom: 24px; }

.hero h1 { margin: 4px 0px 8px; font-size: 2rem; }

.hero-copy { margin: 0px; color: var(--muted); max-width: 640px; }

.eyebrow { margin: 0px; text-transform: uppercase; letter-spacing: 0.3em; f=
ont-size: 0.74rem; color: var(--accent); }

.hero-badge { padding: 10px 14px; border-radius: 999px; background: rgba(61=
, 181, 255, 0.16); color: var(--accent); border: 1px solid rgba(61, 181, 25=
